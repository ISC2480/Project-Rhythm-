[sub_resource type="GDScript" id="GDScript_eyi13"]
script/source = "extends Control


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS


func _on_return_pressed() -> void:
	var pause := get_tree().get_first_node_in_group(\"pause\") as Control


	hide()
	pause.show()
"

