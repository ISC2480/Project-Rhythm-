[sub_resource type="GDScript" id="GDScript_hpwev"]
script/source = "extends Label

var time_elapsed: float = 0.0
var is_stopped: bool = false

func _process(delta: float) -> void:
	if not is_stopped:
		time_elapsed += delta
		text = format_time(time_elapsed)

# Formats time into MM:SS:CC (Minutes:Seconds:Centiseconds)
func format_time(time: float) -> String:
	var minutes: int = int(time) / 60
	var seconds: int = int(time) % 60
	var centiseconds: int = int((time - int(time)) * 100)
	
	# %02d ensures numbers under 10 have a leading zero (e.g., \"05\")
	return \"%02d:%02d:%02d\" % [minutes, seconds, centiseconds]

# Call this from other scripts to stop the stopwatch
func stop() -> void:
	is_stopped = true

# Call this to reset the stopwatch
func reset() -> void:
	time_elapsed = 0.0
	text = format_time(time_elapsed)

# Call this to resume tracking
func start() -> void:
	is_stopped = false
"

